
module CPU {
    
    parameters {
        int nCores;
        int bw;
    }
    
    build {
        for (int i = 0; i < nCores; i += 1) {
            bool performance = (i < 2);
            add CPUCore(
                bw=bw,
                performance=performance
            ) cores[i];
        }
    }
    
    inputs {
        
    }
    
    outputs {
        
    }
    
};
