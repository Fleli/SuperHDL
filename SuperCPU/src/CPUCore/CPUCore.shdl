
module CPUCore {
    
    parameters {
        int bitWidth;
        bool performance;
    }
    
    private {
        int nALUs = 1;
    }
    
    inputs {
        bit clk;
    }
    
    outputs {
        
    }
    
    build {
        
        if performance {
            nALUs = 4;
        }
        
        for (int i = 0; i < nALUs; i++) {
            add CPUCoreALU(bitWidth=bitWidth) alus[i];
        }
        
        add Register(bitWidth=bitWidth) instructionPointer;
        
    }
    
    always {
        for (int i = 0; i < nALUs; i++) {
            alus[i].clk = self.clk;
        }
    }
    
}
