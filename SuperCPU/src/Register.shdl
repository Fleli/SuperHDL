
module Register {
    
    parameters {
        int bitWidth
    }
    
    inputs {
        bit clk;
        bit reset;
        bit[bitWidth-1 : 0] d;
    }
    
    outputs {
        bit[bitWidth-1 : 0] q;
        bit parity;                 # basically just for language feature show
    }
    
    build {
        add XORReducer(bitWidth=bitWidth) parityXORReducer;
    }
    
    when rise(clk) {
        if reset {
            q = 0;
        } else {
            q = d;
        }
    }
    
    always {
        parityXORReducer.operands = q;
        parity = parityXORReducer.reduced;
    }
    
}
