
module CPUCoreALU {
    
    parameters {
        int bitWidth;
    }
    
    build {
        add ALUADD(bitWidth=bitWidth) logicAdd;
        add ALUXOR(bitWidth=bitWidth) logicXor;
        add ALUNAND(bitWidth=bitWidth) logicNand;
        add Register(bitWidth=bitWidth) d1;
        add Register(bitWidth=bitWidth) d2;
    }
    
    inputs {
        bit clk;
        ALUOperation selector;
    }
    
    outputs {
        bit[bitWidth-1 : 0] q;
    }
    
    always {
        if operation == ALUOperation.XOR {
            q = logicXor.q;
        } else if operation == ALUOperation.ADD {
            q = logicAdd.q;
        } else if operation == ALUOperation.NAND {
            q = logicNand.q;
        }
    }
    
    always {
        logicAdd.d1 = d1.q;
        logicAdd.d2 = d2.q;
        logicXor.d1 = d1.q;
        logicXor.d2 = d2.q;
        logicNand.d1 = d1.q;
        logicNand.d2 = d2.q;
    }
    
}
