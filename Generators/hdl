#!/usr/bin/env zsh

set -euo pipefail

if (( $# != 1 )); then
    print -u2 "Usage: hdl <ModuleName>"
    exit 1
fi

module_name="$1"
script_directory="${0:A:h}"
repository_root="${script_directory:h}"
target_configuration="$script_directory/hdl.target"

if [[ ! -r "$target_configuration" ]]; then
    print -u2 "hdl: cannot read $target_configuration"
    exit 1
fi

target_path="$(< "$target_configuration")"

if [[ -z "$target_path" ]]; then
    print -u2 "hdl: $target_configuration is empty"
    exit 1
fi

if [[ "$target_path" = /* ]]; then
    target_directory="$target_path"
else
    target_directory="$repository_root/$target_path"
fi

if [[ ! -d "$target_directory" ]]; then
    print -u2 "hdl: configured target $target_directory does not exist"
    exit 1
fi

if [[ ! "$module_name" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then
    print -u2 "hdl: module names must start with a letter or underscore and contain only letters, digits, and underscores"
    exit 1
fi

module_directory="$target_directory/$module_name"
module_file="$module_directory/$module_name.shdl"

if [[ -e "$module_directory" ]]; then
    print -u2 "hdl: $module_directory already exists"
    exit 1
fi

mkdir "$module_directory"

cat > "$module_file" <<EOF
module $module_name {
    
    private {
        
    }
    
    build {
        
    }
    
}
EOF

print "Created $module_file"
code --reuse-window --goto "$module_file:1:1"
