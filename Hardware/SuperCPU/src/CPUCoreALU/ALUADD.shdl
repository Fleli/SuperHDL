
module ALUADD {
    
    int bw;
    
    in bit cIn;
    in bit[bw-1 : 0] d1;
    in bit[bw-1 : 0] d2;
    
    out bit cOut;
    out bit[bw-1 : 0] q;
    
    always {
        # Hardware addition explicitly returns tuples; carry (2nd element) can be discarded
        # with Python-like syntax q, _ = ...;
        q, cOut = cIn + d1 + d2;
    }
    
}
