
# Basic design of multi-core CPU
# Will not worry about memory caching for now; assuming
# such low clock frequency that memory isn't a bottleneck
# (at least while designing core of it + HDL compiler)
module CPU {
    
    parameters {
        int nCores;
        int bw;
    }
    
    build {
        
        for (int i = 0; i < nCores; i += 1) {
            bool performance = (i < 2);
            add CPUCore(
                bw=bw,
                performance=performance
            ) cores[i];
        }
        
    }
    
    inputs {
        bit clk;
    }
    
    outputs {
        
    }
    
    always {
        for (int i = 0; i < nCores; i += 1) {
            cores[i].clk = self.clk;
        }
    }
    
};
