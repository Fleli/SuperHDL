
module Register {
    
    int bw;
    
    in bit clk;
    in bit reset;
    in bit[bw-1 : 0] d;
    
    out bit[bw-1 : 0] q;
    out bit parity;                 # basically just for language feature show
    
    build {
        add XORReducer(bw=bw) parityXORReducer;
    }
    
    when rise(clk) {
        if reset {
            q = 0;
        } else {
            q = d;
        }
    }
    
    always {
        parityXORReducer.operands = q;
        parity = parityXORReducer.reduced;
    }
    
}
