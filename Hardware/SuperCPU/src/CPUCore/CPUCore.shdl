
module CPUCore {
    
    int bw;
    bool performance;
    
    private {
        int nALUs = 1;
    }
    
    in bit clk;
    
    build {
        
        if performance {
            nALUs = 4;
        }
        
        for (int i = 0; i < nALUs; i++) {
            add CPUCoreALU(bw=bw) alus[i];
        }
        
        add Counter(bw=bw) instructionPointer;
        
        # TODO: Remember to wire tState.d
        add Counter(bw=CPU_CORE_T_STATES_BIT_WIDTH) tState;
        
    }
    
    always {
        
        for (int i = 0; i < nALUs; i++) {
            alus[i].clk = self.clk;
        }
        
        tState.clk = self.clk;
        tState.count = true;
        tState.jump = false;
        
    }
    
}
