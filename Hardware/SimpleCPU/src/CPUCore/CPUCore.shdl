
module CPUCore {
    
    parameters {
        int bw;
    }
    
    inputs {
        bit clk;
    }
    
    outputs {
        
    }
    
    private {
        bit[bw-1 : 0] bus;
    }
    
    build {
        
        add CPUCoreALU(bw=bw) alu;
        
        add Counter(bw=bw) instructionPointer;
        
        # TODO: Remember to wire tState.d
        add Counter(bw=CPU_CORE_T_STATES_BIT_WIDTH) tState;
        
        for (int i = 0; i < CPU_CORE_N_GENERAL_PURPOSE_REGISTERS; i++) {
            add Register(bw=bw) reg[i];
        }
        
    }
    
    always {
        
        alu.clk = self.clk;
        
        tState.clk = self.clk;
        tState.count = true;
        tState.jump = false;
        
    }
    
    always {
        
        
        
    }
    
}
