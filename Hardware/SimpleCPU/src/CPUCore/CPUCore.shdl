
module CPUCore {
    
    init {
        int bw;
    }
    
    inputs {
        bit clk;
    }
    
    outputs {
        
    }
    
    private {
        bit[bw-1 : 0] bus;
        bit[CPU_CORE_REGISTER_SELECT_BW-1 : 0] selectedRegister;
    }
    
    public {
        
    }
    
    build {
        
        add CPUCoreALU(bw=bw) alu;
        
        add Counter(bw=bw) programCounter;
        add Register(bw=bw) instructionRegister;
        
        # TODO: Remember to wire tState.d
        add Counter(bw=CPU_CORE_T_STATES_BIT_WIDTH) tState;
        
        for (int i = 0; i < CPU_CORE_N_REGISTERS; i++) {
            add Register(bw=bw) reg[i];
        }
        
        add Decoder(bw=bw) decoder;
        
    }
    
    always {
        
        alu.clk = self.clk;
        
        tState.clk = self.clk;
        tState.count = true;
        tState.jump = false;
        
    }
    
    always {
        
        # I guess the compiler needs to solve a Constraint
        # Satisfaction Problem to solve this.
        for (int i = 0; i < CPU_CORE_N_REGISTERS; i++) {
            # should we have a cast from int i to bit[2:0] for comparison?
            if selectedRegister == i {
                bus = reg[i];
            }
        }
        
        if selectedRegister == CPU_CORE_N_REGISTERS {
            bus = 0;
        }
        
    }
    
    always {
        
    }
    
}
