module Counter {
    
    init {
        int bw;
    }
    
    private {
        
    }
    
    inputs {
        bit clk;
        bit count;
        bit jump;
        bit[bw-1 : 0] d;
    }
    
    outputs {
        bit[bw-1 : 0] q;
        bit overflow;
    }
    
    build {
        
    }
    
    when rise(clk) {
        if jump {
            q = d;
            overflow = 0;
        } else if count {
            q, overflow = q + 1;
        }
    }
    
}
