module Counter {
    
    int bw;
    
    private {
        
    }
    
    in bit clk;
    in bit count;
    in bit jump;
    in bit[bw-1 : 0] d;
    
    out bit[bw-1 : 0] q;
    out bit overflow;
    
    build {
        
    }
    
    when rise(clk) {
        if jump {
            q = d;
            overflow = 0;
        } else if count {
            q, overflow = q + 1;
        }
    }
    
}
